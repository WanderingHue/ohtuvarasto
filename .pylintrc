[MAIN]

ignore=tests
max-line-length = 80
max-nested-blocks = 2
max-statements = 15
variable-naming-style = snake_case
include-naming-hint = True

[MESSAGE CONTROL]

disable=raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        use-symbolic-message-instead,
        missing-module-docstring,
        missing-function-docstring,
        missing-class-docstring

[FORMAT]

[REFACTORING]

[DESIGN]
